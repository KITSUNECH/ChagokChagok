<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량 신호 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 일기 문장을 생성형 AI로 다듬을 때만 쓴다. 주행 요약 글만 나간다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 음성 안내 (Pleos TextToSpeech) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 위치: 한마디를 남긴 자리에 가까워졌는지 본다 (Pleos FusedLocation, 실행 중 허락을 받는다) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 내비 연동 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 기기에 깔린 음성 읽기 엔진을 찾을 수 있게 한다. 이 선언이 없으면 엔진이 있어도 보이지 않는다. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="차곡車곡"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중에도 화면을 유지하겠다는 선언. 주행 중 화면은 한 줄만 보여 준다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 글레오가 호출하는 기능 세 가지 (assets/schema.json 과 이름이 같아야 한다) -->
        <!-- 공모전 참가팀은 Gleo Interface(App Schema) 검토·승인을 신청할 수 없어 제출판에서는 꺼 둔다.
             켜면 다른 앱이 일기 내용을 요청할 수 있으므로, 승인 절차가 열리면 권한과 함께 다시 켠다. -->
        <receiver android:name=".GleoReceiver" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="READ_LATEST_DIARY" />
                <action android:name="GET_NEXT_ROUTE" />
                <action android:name="CHECK_DRIVING_PROGRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
