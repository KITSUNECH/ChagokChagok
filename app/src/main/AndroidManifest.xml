<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량 신호 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 차대번호 (CarInfo.getVINInfo) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- 기어: AAOS 표준 GEAR_SELECTION 속성 (Pleos 문서 권장, Vehicle SDK Gear는 지원 중단) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 속도: AAOS 표준 PERF_VEHICLE_SPEED 속성 (Pleos 문서 안내). 급하게 선 순간을 알아보는 데만 쓴다. 실행 중 허락을 받는다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 일기 문장을 생성형 AI로 다듬을 때만 쓴다. 주행 요약 글만 나간다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 기록 중 알림(앞쪽 서비스): 내비 전체 화면·앱 전환 중에도 기록이 끊기지 않게 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 음성 안내 (Pleos TextToSpeech) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 위치: 한마디를 남긴 자리에 가까워졌는지 본다 (Pleos FusedLocation, 실행 중 허락을 받는다) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 내비 연동 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 내비 화면 열기 (NaviHelper.requestNavigationScreen) -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <!-- 기기에 깔린 음성 읽기 엔진을 찾을 수 있게 한다. 이 선언이 없으면 엔진이 있어도 보이지 않는다. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="차곡차곡"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중에도 화면을 유지하겠다는 선언. 주행 중 화면은 한 줄만 보여 준다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 글레오가 호출하는 기능 세 가지 (assets/schema.json 과 이름이 같아야 한다) -->
        <!-- Gleo AI 연동 (App Integration Guide). 공모전 참가팀은 Gleo Interface 를 별도 승인 없이 쓸 수 있다 (공모전 공지). -->
        <receiver android:name=".GleoReceiver" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="TAKE_IT_SLOW" />
                <action android:name="SAVE_NOTE_HERE" />
                <action android:name="ASK_MY_DRIVING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
        <service android:name=".TripService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps an in-progress driving record alive while the driver uses navigation full screen. Stops when the car is put in P." />
        </service>
    </application>
</manifest>
